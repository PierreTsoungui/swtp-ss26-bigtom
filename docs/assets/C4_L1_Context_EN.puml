@startuml C4_Level1_SystemContext
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context Diagram - MethylAnalyzer (BigTom)
' As of: July 2026 - based on v1.2.0

LAYOUT_WITH_LEGEND()

Person(User, "User", "User of the platform, uploads IDAT files and sample sheets, configures filter, normalization, batch correction and analysis settings, and retrieves results. No distinct roles.")

System(methylAnalyzer, "MethylAnalyzer", "Web-based platform for analyzing DNA methylation data. Supports filtering, normalization, batch effect correction, DMP/DMR analysis, visualization, and export.")

skinparam rectangle {
  BackgroundColor #DDDDDD
  BorderColor #666666
  FontSize 14
  RoundCorner 10
  Shadowing true
}

rectangle "<b>Illumina IDAT Files</b>\n\n<<Input Artifact>>\nRaw DNA methylation array files" as idatFiles #DDDDDD
rectangle "<b>Sample Sheet</b>\n\n<<Input Artifact>>\nSample metadata file" as sampleSheet #DDDDDD

Rel(User, methylAnalyzer, "Uploads data, configures analysis steps, views and exports results", "HTTPS")
Rel(idatFiles, methylAnalyzer, "Provides raw methylation input data")
Rel(sampleSheet, methylAnalyzer, "Provides sample metadata")

SHOW_LEGEND()

note right of methylAnalyzer
  No external software system or service involved:
  - no external database
  - no external authentication provider
  - no cloud storage
  - no third-party analysis service

end note

@enduml
