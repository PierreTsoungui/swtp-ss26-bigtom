@startuml DNA-Methylation Analysis Workflow

title DNA-Methylation Analysis Workflow\nVersion v0.4.0 (Juin 2026)

skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5
skinparam sequenceParticipant underline

actor       "User"             as User
participant "Frontend\n(React)" as FE
participant "FastAPI\nBackend"  as BE
participant "R Worker"          as R

' ============================================================
' 1. UPLOAD & FILTERUNG
' ============================================================

group Upload & Filterung

  User -> FE : Upload IDAT-Dateien + Sample Sheet\n(+ Filter-Einstellungen)
  FE  -> BE  : POST /api/v1/upload
  BE  --> FE : HTTP 201 { job_id, status:"queued" }

  BE  -> R   : Rscript init_filter.R

  note right of R
    Filterung mit minfi:
    - detP, Bead-Count, Non-CpG
    - SNP, Multi-Hit, XY-Chromosomen
    - PCA Outlier Filter
  end note

  loop Polling toutes les 1500ms
    FE  -> BE  : GET /api/v1/status/{job_id}
    BE  --> FE : { status, phase:"filtering", progress_percent }
  end

  R   --> BE  : filter_stats.json

  FE  -> BE  : GET /api/v1/filter/{job_id}/stats
  BE  --> FE : Filterstatistiken

end

' ============================================================
' 2. NORMALIZATION PREVIEW
' ============================================================

group Normalisierungs-Vorschau

  BE  -> R   : Rscript normalization_preview.R

  note right of R
    Preview-Plots:
    density, pca, scatterplots
  end note

  R   --> BE  : Preview-Plots

  FE  -> BE  : GET /api/v1/preview/normalization/{job_id}
  BE  --> FE : { plots }

  FE  -> BE  : GET /api/v1/preview/normalization/{job_id}/{plot_name}
  BE  --> FE : PNG

end

' ============================================================
' 3. NORMALISIERUNG (avec polling conditionnel)
' ============================================================

group Normalisierung

  User -> FE : Normalisierungsmethode wählen
  FE  -> BE  : POST /api/v1/normalize/{job_id}\n{ method }
  BE  --> FE : HTTP 202

  FE  -> FE  : set isNormalising = true (déclenche polling)

  BE  -> R   : Rscript normalize.R

  loop Polling uniquement si isNormalising=true
    FE  -> BE  : GET /api/v1/status/{job_id}
    BE  --> FE : { phase:"normalizing", progress_percent }
  end

  R   --> BE  : normalized_data.rds

  BE  -> R   : Rscript batch_svd.R (baseline round 0)
  R   --> BE  : svd_plot_0.png

  BE  -> BE  : update_job(status:"ready_for_batch")

  note right of FE
    Le polling s'arrête car status="ready_for_batch"
    est dans TERMINAL_STATES
  end note

end

' ============================================================
' 4. BATCH-EFFEKT-KORREKTUR (POLLING ACTIF)
' ============================================================

group Batch-Effekt-Korrektur

  FE  -> BE  : GET /api/v1/batch/{job_id}/history
  BE  --> FE : { rounds, current_round }

  FE  -> BE  : GET /api/v1/batch/{job_id}/batch-options
  BE  --> FE : { available_columns }

  alt Batch Correction

    User -> FE : Batch-Variable + Kovariaten wählen
    FE  -> BE  : POST /api/v1/batch/{job_id}
    BE  --> FE : HTTP 202

    FE  -> FE  : setShowProgressBar(true) + pollingKey++ (reset polling)

    BE  -> R   : Rscript batch_svd.R
    R   --> BE  : batch_history.json

    BE  -> R   : Rscript batch_correct.R

    loop Polling actif (useJobPolling dans BatchPage)
      FE  -> BE  : GET /api/v1/status/{job_id}
      BE  --> FE : { phase:"batch_correction", progress_percent }
    end

    R   --> BE  : corrected_data.rds

  else Skip

    User -> FE : Skip
    FE  -> BE  : POST /api/v1/batch/{job_id}/skip
    FE  -> FE  : setShowProgressBar(true) + pollingKey++

    loop Polling pendant le skip
      FE  -> BE  : GET /api/v1/status/{job_id}
    end

  end

  BE  -> BE  : update_job(phase:"downstream_analysis")

  note right of FE
    Le polling continue car "downstream_analysis"
    n'est pas dans TERMINAL_STATES
  end note

end

' ============================================================
' 5. DOWNSTREAM ANALYSE (DMR & DMP)
' ============================================================

group Downstream-Analyse

  BE  -> R   : Rscript dmr.R
  R   --> BE  : dmr_results

  BE  -> R   : Rscript dmp.R
  R   --> BE  : dmp_results

  loop Polling continue (AnalysisPage)
    FE  -> BE  : GET /api/v1/status/{job_id}
    BE  --> FE : { phase:"downstream_analysis", progress_percent }
  end

  BE  -> BE  : update_job(status:"analysis_done")

  note right of FE
    Le polling s'arrête car "analysis_done"
    est dans TERMINAL_STATES
  end note

end

' ============================================================
' 6. ERGEBNISSE ABRUFEN (pas de polling)
' ============================================================

group Ergebnisse abrufen

  FE  -> BE  : GET /api/v1/table/{job_id}/dmr?page=1
  BE  --> FE : { data, total, page, page_size=75 }

  FE  -> BE  : GET /api/v1/table/{job_id}/dmp?page=1
  BE  --> FE : { data, total, page, page_size=75 }

  note right of FE
    Pas de polling ici
    Requêtes HTTP normales (GET)
  end note

end

' ============================================================
' 7. RESET
' ============================================================

group Reset

  User -> FE : Analyse abbrechen
  FE  -> BE  : POST /api/v1/reset/{job_id}
  BE  -> BE  : kill_process + reset_job
  BE  --> FE : { status:"canceled" }

end

@enduml