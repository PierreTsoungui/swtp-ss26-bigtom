# ── Job storage & lifecycle ───────────────────────────────────────────────────
JOB_BASE_DIR=/app/jobs
JOB_RETENTION_HOURS=24
JOB_CLEANUP_INTERVAL_SECONDS=86400

# ── Staging (folder/ZIP upload inspect) ───────────────────────────────────────
# Unconfirmed uploads live here until the user commits a selection.
STAGING_BASE_DIR=/app/staging
STAGING_RETENTION_HOURS=2
STAGING_CLEANUP_INTERVAL_SECONDS=900

# ── R compute parallelism ─────────────────────────────────────────────────────
# Cores handed to dmr.R for its bootstrap step (capped at the host's cores).
DMR_CORES=4

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
# In production set this to the deployed frontend origin(s), e.g.
# https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://localhost,https://127.0.0.1

# ── Upload limits (megabytes) ─────────────────────────────────────────────────
MAX_TOTAL_UPLOAD_MB=900
MAX_SAMPLE_SHEET_MB=10

# ── Logging ───────────────────────────────────────────────────────────────────
# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
# Use INFO (or higher) in production.
LOG_LEVEL=DEBUG
