# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to  .env  (docker compose reads .env automatically; .env is
#  gitignored so each machine/server keeps its own). Then `docker compose up -d`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Job storage & lifecycle ───────────────────────────────────────────────────
JOB_BASE_DIR=/app/jobs
JOB_RETENTION_HOURS=24
JOB_CLEANUP_INTERVAL_SECONDS=86400

# ── Staging (folder/ZIP upload inspect) ───────────────────────────────────────
# Unconfirmed uploads live here until the user commits a selection.
STAGING_BASE_DIR=/app/staging
STAGING_RETENTION_HOURS=2
STAGING_CLEANUP_INTERVAL_SECONDS=900

# ── Deployment hardware budget (resource governor + hard container limits) ────
# The app protects itself on TWO layers, both sized from the values below:
#   1. HARD WALL  — the r_worker container mem_limit/cpus. If the container tries
#      to use more, ITS OWN cgroup OOM-killer stops the R process; the host and
#      any other apps on the machine stay alive. This is the crash-proof
#      guarantee and it holds even if the memory estimates are wrong.
#   2. SOFT QUEUE — the backend admits R steps against MEMORY_BUDGET/CORE_BUDGET
#      and QUEUES the rest, so under load the app gets slower instead of failing.
#
#  Golden rules (so the host can never be OOM-killed):
#   * R_WORKER_MEM_LIMIT + BACKEND_MEM_LIMIT + (other apps' limits) + OS headroom
#     must be <= the machine's PHYSICAL RAM. The limit is a CEILING, not a
#     reservation: if you set it higher than what is actually free, the host can
#     still run out.
#   * PIPELINE_MEMORY_BUDGET_GB <= R_WORKER_MEM_LIMIT  (the queue engages first).
#   * R_WORKER_MEM_LIMIT >= the largest single step (DMR) so one job can run.

# Hard container walls.
R_WORKER_MEM_LIMIT=10g
R_WORKER_CPUS=2
BACKEND_MEM_LIMIT=1g

# Soft admission-control budget (backend queue). Mirror the hard walls.
PIPELINE_MEMORY_BUDGET_GB=8
PIPELINE_CORE_BUDGET=2

# Per-step peak-memory estimates (GiB), from benchmarks/. Used ONLY by the soft
# queue to decide how many steps may run together. If these are too LOW the queue
# admits too much, but the hard wall still prevents a host crash (jobs fail
# instead). Keep them realistic and re-measure after data/algorithm changes.
PIPELINE_STEP_MEMORY_GB=5
PIPELINE_DMR_MEMORY_GB=6
PIPELINE_DMP_MEMORY_GB=4

# Bootstrap cores for dmr.R (also DMR's core weight in the queue). Each core is a
# separate worker holding a COPY of the beta matrix, so this MULTIPLIES DMR RAM.
# Keep at 1 on memory-tight machines; raise on big servers (and raise
# PIPELINE_DMR_MEMORY_GB accordingly).
DMR_CORES=1

# ── Intake guards (0 = unlimited) ─────────────────────────────────────────────
# Reject a job at UPLOAD if it would blow the budget, with a clear message —
# instead of letting it start and get OOM-killed / fill the disk mid-pipeline.
# MAX_SAMPLES_PER_JOB: peak RAM scales with sample count; tune to the RAM budget
#   (benchmark first). 48 is a generous default for a modest server.
# MAX_JOBS_DISK_GB: total size cap for ALL job dirs combined; a new upload is
#   refused above it. Size to the machine's disk. 0 = off (recommended to set!).
MAX_SAMPLES_PER_JOB=48
MAX_JOBS_DISK_GB=0

# ── Upload limits (megabytes) ─────────────────────────────────────────────────
MAX_TOTAL_UPLOAD_MB=900
MAX_SAMPLE_SHEET_MB=10

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
# In production set this to the deployed frontend origin(s), e.g.
# https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://localhost,https://127.0.0.1

# ── Logging ───────────────────────────────────────────────────────────────────
# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
# Use INFO (or higher) in production.
LOG_LEVEL=INFO

# ── Sizing examples ───────────────────────────────────────────────────────────
# Dev laptop (16 GiB, shares RAM with the IDE/OS → ~10 GiB usable for us):
#   R_WORKER_MEM_LIMIT=10g  R_WORKER_CPUS=2
#   PIPELINE_MEMORY_BUDGET_GB=8   PIPELINE_CORE_BUDGET=2   DMR_CORES=1
#   → 1 job at a time. Never crashes the machine even with the IDE + browser open.
#
# Server that dedicates 20 GiB + 5 cores to THIS app (other apps run too):
#   R_WORKER_MEM_LIMIT=19g  R_WORKER_CPUS=5   BACKEND_MEM_LIMIT=1g
#   PIPELINE_MEMORY_BUDGET_GB=18  PIPELINE_CORE_BUDGET=5
#   PIPELINE_DMR_MEMORY_GB=6  DMR_CORES=2
#   → ~3 concurrent DMRs (18/6). Because 19g+1g = 20g is a hard ceiling, the app
#     can NEVER use more than its dedicated 20 GiB — the other apps' RAM is safe,
#     and CPU contention only slows us down (throttled), it does not crash us.
