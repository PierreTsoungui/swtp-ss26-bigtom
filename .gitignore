# =====================================================
# METHYLOME ANALYZER – .gitignore
# =====================================================


# ─── Jobs (Patientendaten – niemals ins Repo) ────────
# Verzeichnis behalten (als Bind-Mount-Ziel), aber den gesamten Inhalt ignorieren.
# /jobs muss auf dem Host existieren, sonst legt Docker es beim Bind-Mount als
# root an und der Backend-Prozess (UID 1000) kann nicht hineinschreiben.
/jobs/*
!/jobs/.gitkeep


# ─── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
backend/venv/
backend/.venv/
backend/app/__pycache__
backend/app/api/routes/__pycache__

# pytest
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# mypy
.mypy_cache/
.dmypy.json


# ─── R ───────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.Rproj
*.Rout
*.rdb
*.rdx

# R temp files
/tmp/


# ─── Node / Frontend ─────────────────────────────────
node_modules/
frontend/app/node_modules/
frontend/app/dist/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite cache
frontend/app/.vite/


# ─── Docker ──────────────────────────────────────────
# Docker legt keine Dateien im Repo an – aber falls doch:
*.dockerenv
.docker/


# ─── Environment & Secrets ───────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
certs/*
!certs/.gitkeep
secrets/


# ─── IDEs & Editoren ─────────────────────────────────
# VSCode
.vscode/
*.code-workspace

# IntelliJ / PyCharm
.idea/
*.iml
*.iws
*.ipr

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ethumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory


# ─── Logs & temporäre Dateien ────────────────────────
*.log
*.tmp
*.temp
*.bak
*.orig
*.pid


# ─── Testdaten (echte IDAT-Dateien) ──────────────────
# Kleine synthetische Mock-Daten dürfen rein,
# echte Patientendaten niemals
backend/tests/data/*.idat
backend/tests/data/206*/


# ─── Kompilierte Dateien ─────────────────────────────
*.o
*.so
*.dll
*.dylib
